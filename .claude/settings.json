{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(**/.secrets/**)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_rsa.pub)",
      "Read(**/id_ed25519)",
      "Read(**/id_ed25519.pub)",
      "Read(**/.ssh/**)",
      "Read(**/known_hosts)",
      "Read(**/known_hosts.*)",
      "Read(**/wireguard/**)",
      "Read(**/wg*.conf)",
      "Read(**/openvpn/**)",
      "Read(**/*.ovpn)",
      "Read(**/vnc/**)",
      "Read(**/server-setup/inventory/*.yml)",
      "Read(**/server-setup/inventory/*.yaml)",
      "Read(**/inventory/*.yml)",
      "Read(**/inventory/*.yaml)",
      "Read(**/inventory.yml)",
      "Read(**/inventory.yaml)",
      "Read(**/hosts.yml)",
      "Read(**/hosts.yaml)",
      "Read(**/hosts.ini)",
      "Read(**/group_vars/**)",
      "Read(**/host_vars/**)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)",
      "Read(**/*.tfvars)",
      "Bash(sudo:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(git push:*)",
      "Bash(docker push:*)",
      "Bash(kubectl:*)",
      "Bash(rm -rf /:*)"
    ],
    "ask": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "WebFetch",
      "Bash(docker:*)",
      "Bash(ansible:*)",
      "Bash(ansible-playbook:*)",
      "Bash(terraform:*)",
      "Bash(git commit:*)"
    ],
    "allow": [
      "Bash(yarn lint:*)",
      "Bash(yarn build:*)",
      "Bash(yarn tsc:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ]
  },
  "includeCoAuthoredBy": true
}